# Port the server listens on
PORT=3000

# Optional: a TTN/TTI (The Things Industries) API key for deeper
# per-gateway LoRaWAN connection stats, scoped to gateways registered
# under your own account. https://www.thethingsindustries.com/
# Without it, the LoRaWAN panel still shows the public Packet Broker
# gateway list, just without per-gateway uplink/downlink counts.
TTI_API_KEY=
